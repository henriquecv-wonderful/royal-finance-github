<mxfile host="app.diagrams.net" type="device">
  <diagram id="client-authentication" name="Client authentication">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="client_authentication &#8212; two rungs, one tool" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ADR-009 decides the ladder, ADR-033 how many codes one call can send, ADR-032 how the protocol reaches the caller. Where the drawing and a record disagree, the record is right." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="entry" value="&lt;b&gt;A tool refused, and the call arrived here&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;This skill is never activated because the caller offers to identify themselves or because a request sounds sensitive.&lt;br&gt;It is activated because a refusal asked for it, and it decides nothing about the level or the destination.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="700" height="70" as="geometry" />
        </mxCell>

        <mxCell id="read" value="&lt;b&gt;authenticate_client reads the call&#39;s own state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;authentication_required&lt;/b&gt; the level to reach &#183; &lt;b&gt;authentication_return_point&lt;/b&gt; the skill and tool to go back to&lt;br&gt;&lt;b&gt;auth.ssn_verified&lt;/b&gt; and &lt;b&gt;auth.sms_verified&lt;/b&gt; which rungs already hold&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f6;strokeColor=#1d3557;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="700" height="70" as="geometry" />
        </mxCell>

        <mxCell id="already" value="&lt;b&gt;Already at the level?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Go straight back. Nothing is asked twice&lt;br&gt;on one call, and the caller is never told&lt;br&gt;which checks were done.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="205" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="l1band" value="&lt;b&gt;L1 &#8212; the social security number&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Runs whenever L1 is missing, whatever level was asked for: L2 sits on top of it and never replaces it.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="640" height="630" as="geometry" />
        </mxCell>
        <mxCell id="l1ask" value="&lt;b&gt;1. Ask&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;One short sentence asking for the number.&lt;br&gt;Nothing about how many checks there are,&lt;br&gt;or which one this is.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l1check" value="&lt;b&gt;2. Look it up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;rf-find-client-by-ssn&lt;/i&gt; matches it against&lt;br&gt;the client table. A tool never reads a table.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="400" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l1write" value="&lt;b&gt;3. Write what the call now knows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;client id, first and last name, the number itself, and the phone on file &#8212; which is where L2 will send its code, learned here rather than read again later. Then ssn_verified, and attempts back to zero.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=4;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l1fail" value="&lt;b&gt;No match&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Say it did not match and ask again, without saying how many tries are left. Three in all; after that the account cannot be discussed on this call, and what needs no verification is offered instead.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=4;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="600" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l2band" value="&lt;b&gt;L2 &#8212; a four digit code by SMS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Runs only once L1 holds, and only when L1 was not what was asked for.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#9673a6;fontSize=12;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="330" width="640" height="630" as="geometry" />
        </mxCell>
        <mxCell id="l2target" value="&lt;b&gt;1. Is there a number to reach at all?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;new_phone_number&lt;/b&gt; when a change is in flight, otherwise &lt;b&gt;client.phone_number&lt;/b&gt;. A code sent to the number being left behind would prove nothing about the new one, and with neither set nothing is sent and the caller is not asked to supply a number for it. What this decides is whether the rung can run and what the caller is told the code went to &#8212; not where the message is actually delivered, which is the next box.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacingTop=4;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="400" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2send" value="&lt;b&gt;2. Send it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Four random digits, written to &lt;b&gt;auth.sms_code&lt;/b&gt; and texted with ctx.telephony.sendSms. The code goes to KV and never into a reply: everything a tool returns lands in the model&#39;s context, and a code the model can see is a code it can say.&lt;br&gt;&lt;b&gt;Delivery is the one step diverted&lt;/b&gt;: the message goes to the number held in the Global Variable &lt;i&gt;mocked_sms_phone_number&lt;/i&gt; and not to the target above, so a test call cannot text a real cardholder. The protocol message goes the same way. Everything else on the rung works on the caller&#39;s own number.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacingTop=4;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="510" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l2check" value="&lt;b&gt;3. Hear it back&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;The caller reads the digits from the message. Wrong ones cost an attempt, and the second wrong answer spends the call&#39;s second code: a new one goes out, only the newest digits work from here, and the attempts start again against it. Two codes is the whole of it &#8212; once the second is spent, the rung is over (ADR-033).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacingTop=4;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="630" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l2write" value="&lt;b&gt;4. On a match&lt;/b&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;  sms_verified is written, the code is cleared, and attempts go back to zero.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="750" width="600" height="40" as="geometry" />
        </mxCell>

        <mxCell id="l2nothing" value="&lt;b&gt;Nothing arrived &amp;#8212; and the tool decides, not the agent&lt;/b&gt;&lt;br&gt;&lt;i&gt;code_not_received&lt;/i&gt; with no digits, read before the digits are looked at: a caller with nothing to read from has not given a wrong answer and is not charged an attempt for one. Under a minute since it went out they are asked to wait, because a text message can take that long. Over a minute a new one goes out while there is one left &amp;#8212; and a caller who insists is answered by the same arithmetic a minute later, which is why insisting needs no state of its own. Two wrong answers, a message that never came and a caller insisting all spend from the same two codes (ADR-033)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d3557;fontSize=10;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="740" y="800" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l1protocol" value="&lt;b&gt;The protocol is minted here, and texted rather than said&lt;/b&gt;&lt;br&gt;&lt;i&gt;rf-generate-service-protocol&lt;/i&gt; mints the call&#x27;s reference the moment L1 holds, and &lt;i&gt;ctx.telephony.sendSms&lt;/i&gt; sends it, stamped with the date and time of the call and diverted to the same mock number the code uses. It is not in the reply that hands the call back, so there is nothing for the model to read out: the tool the call returns to is told the message has gone out and nothing more. A caller who wants the number itself asks for it, and the global &lt;i&gt;get_service_protocol&lt;/i&gt; is the only thing that ever says one aloud (ADR-023, ADR-031, ADR-032). A Function that fails leaves the call without a protocol rather than with a bad one, and verification carries on." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d3557;fontSize=10;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="never" value="&lt;b&gt;Neither value is ever said back to the caller.&lt;/b&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;  Not to confirm it, not to check it was heard right, not when the caller asks, and not when they insist. They are the one who has to produce it. This is the one place the read-back rule is reversed: everything else a caller dictates gets read back, and these two never do.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="back" value="&lt;b&gt;Back to what the call was doing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;A directive names the skill and the tool from the return point: activate it and call that tool again, silently. The caller is not made to repeat the request, and is not told they are now verified.&lt;br&gt;A phone change comes back here twice &#8212; once verified at L1 to confirm the change, and again at L2 before the write happens.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="1100" width="700" height="90" as="geometry" />
        </mxCell>

        <mxCell id="notdoing" value="&lt;b&gt;What this skill does not do&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;It answers nothing about the account, verified or not.&lt;br&gt;It does not say what the checks are or which one the call is on.&lt;br&gt;It does not take the caller&#39;s word that they were verified earlier.&lt;br&gt;It asks for nothing the tool did not ask for.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f9f9;strokeColor=#b3b3b3;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="weak" value="&lt;b&gt;The weak point, stated&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;For a phone change the code goes to the number the change is heading for, so it proves possession of the new handset and not ownership of the account &#8212; by design, since delivery is diverted to the mock number and a test call exercises neither. L1 stands behind it. The stronger design texts the number on file and costs the caller a second call (ADR-009).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1090" width="310" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e-entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entry" target="read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-already" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="already">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l1" value="&lt;font style=&quot;font-size: 10px&quot;&gt;L1 missing&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="l1band">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l2" value="&lt;font style=&quot;font-size: 10px&quot;&gt;L1 holds, L2 asked for&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="l2band">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l1-back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1band" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l2-back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2band" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
