<mxfile host="app.diagrams.net" type="device">
  <diagram id="account-servicing" name="Account servicing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="account_servicing &#8212; the seven tools and the trips to authentication" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ADR-004 puts enforcement in the tools, ADR-009 sets the ladder, ADR-010 the shared card, ADR-011 the spoken values, ADR-012 and ADR-013 the transactions. Where the drawing and a record disagree, the record is right." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="caller" value="&lt;b&gt;Cardholder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;asks about their own account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;The agent, in this skill&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;It calls the tool the request needs before it asks the caller for anything &#8212; not the&lt;br&gt;last four digits of a card, not a date, and never a social security number or a code.&lt;br&gt;The tool answers with what it needs next, in the order the call should happen.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="580" height="80" as="geometry" />
        </mxCell>

        <mxCell id="scope" value="&lt;b&gt;Not this skill&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;taking a payment, reversing a charge, reissuing a card, moving a limit. Reading is here; changing is not. Blocking a card and disputing a charge are in 05-card-blocks-and-disputes, and a limit is moved in 06-change-credit-card-limit.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="client-band" value="&lt;b&gt;About the client&lt;/b&gt; &#8212; no card, no parameters at all&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;The client answered about is the one verified on this call, read from KV. Nobody can ask about an account by naming it.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="620" height="180" as="geometry" />
        </mxCell>
        <mxCell id="balance" value="&lt;b&gt;get_account_balance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;L1 &#183; money in the account,&lt;br&gt;not what is owed on a card&lt;br&gt;&lt;i&gt;rf-get-client-balance&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="preapproved" value="&lt;b&gt;get_pre_approved_limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;L1 &#183; total credit approved,&lt;br&gt;not one card and not credit left&lt;br&gt;&lt;i&gt;rf-get-client-pre-approved-limit&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="265" y="300" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="phone" value="&lt;b&gt;get_contact_phone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;L1 &#183; the number on file&lt;br&gt;marks phone_number_displayed,&lt;br&gt;so a change need not read it again&lt;br&gt;&lt;i&gt;rf-get-client-contact-phone&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="470" y="300" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="card-band" value="&lt;b&gt;About one card&lt;/b&gt; &#8212; the last four digits are a parameter, never a rung (ADR-009)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Whichever tool identifies a card writes it to KV, and the next one reads it there rather than asking again. Digits the caller has just read out win; a different card needs its own four (ADR-010).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d6b656;fontSize=12;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1140" height="210" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;get_card_limits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;L1 &#183; the limit on that card&lt;br&gt;A blocked or canceled card comes&lt;br&gt;back with its status and no figure&lt;br&gt;&lt;i&gt;rf-get-card-by-last-four&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="invoice" value="&lt;b&gt;get_invoice_value&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;L1 &#183; the open invoice and the last&lt;br&gt;closed one behind it. Cannot take a&lt;br&gt;payment: the app is where one is made&lt;br&gt;&lt;i&gt;rf-get-card-invoices&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="320" y="520" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="transactions" value="&lt;b&gt;get_transaction_details&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;L1 &#183; a count for anything broad, and one&lt;br&gt;named day&#39;s transactions. Denials list without&lt;br&gt;a date. A date arrives as MM-DD; the year is&lt;br&gt;worked out here (ADR-012, ADR-013)&lt;br&gt;&lt;i&gt;rf-find-card-transactions&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="590" y="520" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="change" value="&lt;b&gt;change_contact_phone&lt;/b&gt; &#8212; the only write&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;L1&lt;/b&gt; to hear the number on file and confirm&lt;br&gt;the change &#183; &lt;b&gt;L2&lt;/b&gt; before anything is written.&lt;br&gt;The new number goes to KV first, so the code&lt;br&gt;is texted to where the change is heading&lt;br&gt;&lt;i&gt;rf-set-client-phone&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="900" y="520" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="gate" value="&lt;b&gt;Every tool gates itself&lt;/b&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;  &#8212; gateOrRequest(kv, level, self) runs before the tool looks at a single parameter. Below the level it writes authentication_required and authentication_return_point to KV, returns a refusal, and states no figure, no status and no number. Verification is not a gate the call passes through, so a prompt that forgets to verify still cannot produce an answer.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;client_authentication&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Reads from KV which level is needed and where to go back to.&lt;br&gt;Runs the missing rung and returns a directive naming the skill and the tool.&lt;br&gt;See 04-client-authentication.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="800" width="580" height="90" as="geometry" />
        </mxCell>

        <mxCell id="kv" value="&lt;b&gt;What KV carries across the trip&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;auth.*&lt;/b&gt; client id, first and last name, which rungs are verified, attempts used&lt;br&gt;&lt;b&gt;authentication_required&lt;/b&gt; and &lt;b&gt;authentication_return_point&lt;/b&gt; what to reach and where to come back&lt;br&gt;&lt;b&gt;card.id&lt;/b&gt; and &lt;b&gt;card.last_four&lt;/b&gt; the card this call is about&lt;br&gt;&lt;b&gt;client.phone_number&lt;/b&gt;, &lt;b&gt;phone_number_displayed&lt;/b&gt;, &lt;b&gt;new_phone_number&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nothing here reaches the model unless a tool puts it in a reply, which is why every id lives here and only here.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f6;strokeColor=#1d3557;fontSize=12;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="780" width="460" height="130" as="geometry" />
        </mxCell>

        <mxCell id="spoken" value="&lt;b&gt;What the caller hears is composed in the tool&lt;/b&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;  (ADR-011) &#8212; an amount in words end to end, a phone number as &quot;plus 55 11 [READ &#8230;]&quot;, four card digits as two spoken pairs, a count in words, a denial reason as a sentence rather than the token stored. The model is never handed a figure to convert, because a figure it converts is a figure it can get wrong.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e-caller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="caller" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-scope" value="&lt;font style=&quot;font-size: 10px&quot;&gt;says so plainly&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="scope">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-client" value="&lt;font style=&quot;font-size: 10px&quot;&gt;calls&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="client-band">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-card" value="&lt;font style=&quot;font-size: 10px&quot;&gt;calls&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="card-band">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-refuse" value="&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;1.&lt;/b&gt; refusal: the level it needs,&lt;br&gt;and where to come back to&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-return" value="&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;2.&lt;/b&gt; verified: activate this skill&lt;br&gt;and call that tool again, silently&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="twice" value="&lt;font style=&quot;font-size: 10px&quot;&gt;A phone change makes the trip &lt;b&gt;twice&lt;/b&gt;: once for L1 before the caller has confirmed anything, and again for L2 once they have given the new number. The second trip is what proves the new handset is theirs.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f9f9;strokeColor=#b3b3b3;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="680" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="limit-offer" value="&lt;b&gt;A limit read here ends in an offer, and it is the only place one can&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Having said what the card carries, &lt;i&gt;get_card_limits&lt;/i&gt; asks the agent to offer the change in the same breath: a caller who has just heard a limit is one step from wanting it moved, and nowhere else on the call is there a limit established well enough to offer one &amp;#8212; a blocked card has no figure to give out, and the limit skill would refuse it anyway. A yes activates &lt;i&gt;change_credit_card_limit&lt;/i&gt; in the same turn, with the card already established, so the caller is not sent back to the plastic for it.&lt;br&gt;The figure is said &lt;b&gt;once per call&lt;/b&gt;. The tool writes &amp;lt;last four&amp;gt;:&amp;lt;limit&amp;gt; to KV, and the limit tools read that token before their own read-back, so a caller who has just heard the figure does not hear it twice. Both halves are in the token on purpose: another card&#x27;s limit was never stated, and a figure that has since moved is one they have not heard.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f4ee;strokeColor=#b8860b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="230" width="490" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
