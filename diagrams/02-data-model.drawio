          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="investments-note" value="A client pledges &lt;b&gt;a sum, not an asset they chose&lt;/b&gt;: the table holds what is invested and what is held against a limit, and nothing else &amp;#8212; no instrument, maturity, liquidity or valuation date (ADR-021). A pledge is spread across the rows in a stable order, so which row carries it is bookkeeping the caller never hears, and &quot;which of my investments is blocked?&quot; has no answer on this line. A client with no row here holds nothing, which is the same position as holding nothing free." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="interactions-note" value="&lt;b&gt;One row per call, written twice&lt;/b&gt; and keyed by the platform&#x27;s own communication id (ADR-026). &lt;i&gt;record_interaction_result&lt;/i&gt; writes the deeds at OnEnd, from KV rather than off a transcript, and the three booleans are written even as false: a call where nothing was blocked is a fact, and an empty column would be indistinguishable from a call the recorder never reached. &lt;i&gt;record_interaction_tags&lt;/i&gt; adds the three judged attitudes and the enhancer&#x27;s summaries at OnEnhancedFinished (ADR-027). &lt;i&gt;client_id&lt;/i&gt; and &lt;i&gt;protocol_number&lt;/i&gt; are omitted rather than blanked, so a call that never verified anyone leaves them empty. This is the one table the back-office app reads directly (ADR-030)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="760" width="545" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
