        <mxCell id="e4" edge="1" parent="1" source="rf_transactions" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERzeroToOne;endFill=1;startArrow=ERone;startFill=0;strokeColor=#1d3557;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="rf_transaction_disputes" value="1 : 0..1  (transaction_id)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="one-dispute" value="&lt;font style=&quot;font-size: 10px&quot;&gt;A transaction carries &lt;b&gt;at most one&lt;/b&gt; dispute, ever: a charge already disputed never gets a second one, whether that one is still under review, was allowed, or was turned down (ADR-019). rejection_reason is set only on a rejected dispute; interaction_id and summary are empty on every dispute loaded with the table, which had no conversation behind it (ADR-016).&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f9f9;strokeColor=#b3b3b3;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
