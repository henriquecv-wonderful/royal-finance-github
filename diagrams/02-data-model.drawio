        <mxCell id="e5" edge="1" parent="1" source="rf_clients" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERoneToMany;endFill=1;startArrow=ERone;startFill=0;strokeColor=#1d3557;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="rf_client_investments" value="1 : N  (client_id)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
