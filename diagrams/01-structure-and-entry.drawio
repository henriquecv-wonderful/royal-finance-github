<mxfile host="app.diagrams.net" type="device">
  <diagram id="structure-and-entry" name="Structure and entry">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Agent 1 &#8212; structure and entry" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ADR-008 decides routing; ADR-004 and ADR-009 decide verification; ADR-017 and ADR-020 decide what a write costs; ADR-026 decides what the call leaves behind. Where the drawing and a record disagree, the record is right." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="caller" value="&lt;b&gt;Cardholder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;inbound voice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;The agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;base prompt plus every skill's description.&lt;br&gt;It hears the request and activates the skill that owns it.&lt;br&gt;No router tool stands between the two (ADR-008).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="390" height="90" as="geometry" />
        </mxCell>

        <mxCell id="unowned" value="&lt;b&gt;Owned by no skill&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;issuing or replacing a card, taking a payment.&lt;br&gt;A charge is disputed rather than reversed.&lt;br&gt;The prompt says so plainly and names what it can do.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="330" height="90" as="geometry" />
        </mxCell>

        <mxCell id="kb" value="&lt;b&gt;knowledge_information&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;No verification&lt;/b&gt;&lt;br&gt;how a product works: fees and their waivers,&lt;br&gt;rates, rewards, benefits, applications, policies&lt;br&gt;&lt;br&gt;get_royal_finance_cards_general_info&lt;br&gt;asks the Context Hub and answers from&lt;br&gt;the passages it returns, or admits the gap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="svc" value="&lt;b&gt;account_servicing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;the caller's own account. Seven tools, every one of them gating itself&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="svc-l1" value="&lt;b&gt;Six reads, L1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;get_account_balance, get_contact_phone&lt;br&gt;get_pre_approved_limit, get_card_limits&lt;br&gt;get_invoice_value, get_transaction_details&lt;br&gt;each reads through a Function&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="440" y="310" width="210" height="76" as="geometry" />
        </mxCell>
        <mxCell id="svc-l2" value="&lt;b&gt;One write, L2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;change_contact_phone&lt;br&gt;confirms against the number on file,&lt;br&gt;then needs a code texted to the new one&lt;br&gt;before it writes through a Function&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="665" y="310" width="210" height="76" as="geometry" />
        </mxCell>
        <mxCell id="svc-l3" value="&lt;b&gt;A card is a parameter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;not a rung. A tool that needs one&lt;br&gt;takes its last four digits, matched&lt;br&gt;against the caller own cards&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="890" y="310" width="200" height="76" as="geometry" />
        </mxCell>


        <mxCell id="blocks" value="&lt;b&gt;card_blockings_and_transaction_disputes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;what happened to a card, and a charge the cardholder does not recognise. Three tools, three writes, every one of them gating itself&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#b85450;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="1050" height="150" as="geometry" />
        </mxCell>
        <mxCell id="blk-block" value="&lt;b&gt;request_block_card&lt;/b&gt; &#8212; L2&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;blocks or cancels, and says&lt;br&gt;which to recommend: a lost&lt;br&gt;card blocked, a stolen one&lt;br&gt;cancelled (ADR-017)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="blk-unlock" value="&lt;b&gt;request_unlock_card&lt;/b&gt; &#8212; L2&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;lifts a block. A canceled&lt;br&gt;card cannot be brought&lt;br&gt;back into use, for any&lt;br&gt;reason, by anyone&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="415" y="510" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="blk-dispute" value="&lt;b&gt;file_transaction_dispute&lt;/b&gt; &#8212; L2&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;lists a day&#39;s charges, then opens one dispute&lt;br&gt;per charge the caller picks. A charge gets one&lt;br&gt;dispute ever, and a denied one gets none&lt;br&gt;(ADR-015, ADR-019). See 05-card-blocks-and-disputes.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="730" y="510" width="360" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e-blocks" value="&lt;font style=&quot;font-size: 10px&quot;&gt;activates&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="blocks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="limit" value="&lt;b&gt;change_credit_card_limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;raising or lowering the limit on one card, and the only route to either. Three tools, three writes, every one of them gating itself&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f4ee;strokeColor=#b8860b;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="1050" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lim-up" value="&lt;b&gt;request_increase_credit_card_limit&lt;/b&gt; &amp;#8212; L1, then L2 before the write&lt;br&gt;every request for more limit enters here. It raises as far as the credit already approved allows, and where the figure does not fit, its reply hands the call to the next tool in the same turn and in silence (ADR-020)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="710" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lim-guar" value="&lt;b&gt;request_increase_credit_card_limit_with_guarantees&lt;/b&gt; &amp;#8212; L1, then L2&lt;br&gt;a limit past that approval, held up two to one by investments the cardholder holds here. Where they cannot cover it, it refuses with the largest limit they do support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="415" y="710" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lim-down" value="&lt;b&gt;request_reduce_credit_card_limit&lt;/b&gt; &amp;#8212; L1, then L2&lt;br&gt;lowers a limit and releases the investment that was held for it. Raising the approved credit itself has no route anywhere and is refused here, with the reason. See 05 and 06." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="710" width="360" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e-limit" value="&lt;font style=&quot;font-size: 10px&quot;&gt;activates&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="blocks" target="limit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ladder" value="&lt;b&gt;The ladder, in lib/auth.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;L1&lt;/b&gt; social security number verified &#8212; &lt;b&gt;L2&lt;/b&gt; L1 plus a four digit code confirmed by SMS. Both built; there is no rung above them (ADR-009)&lt;br&gt;State lives in KV. The client a tool answers about comes from there, never from a parameter, so no caller can ask about an account by naming it. A gated tool records the level it needs and where to return, and authentication reads both.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f6;strokeColor=#1d3557;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="1050" height="70" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;client_authentication&lt;/b&gt; &#8212; one tool, both rungs&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Where a tool refusal sends the call. It reads from KV which level is needed and where to return, runs whichever rung is missing, writes the KV the ladder reads, and returns a directive back to the tool that asked. Neither the social security number nor the code is ever said back to the caller.&lt;br&gt;A knowledge question never reaches it, because nothing in that skill is gated.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="910" width="690" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t0note" value="&lt;font style=&quot;font-size: 10px&quot;&gt;Published information needs no verification, so this path never reaches authentication. That is what the skill is for.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f9f9;strokeColor=#b3b3b3;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="enforce" value="&lt;b&gt;Enforcement lives in the tools.&lt;/b&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;  Verification is not a gate the call passes through, so every tool that touches account data calls authGate itself and refuses below its level, returning a directive to authenticate instead of any figure. A prompt that forgets to verify cannot produce a balance (ADR-004).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="1050" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="caller" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;font style=&quot;font-size: 10px&quot;&gt;declines&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="unowned">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;font style=&quot;font-size: 10px&quot;&gt;activates&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="kb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;font style=&quot;font-size: 10px&quot;&gt;activates&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;font style=&quot;font-size: 10px&quot;&gt;refusal below the level&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="globals" value="&lt;b&gt;Three tools belong to no skill&lt;/b&gt;, and are registered once in &lt;i&gt;config.json&lt;/i&gt; under &lt;i&gt;behavior.global_tools&lt;/i&gt; rather than in any &lt;i&gt;skill.json&lt;/i&gt; &amp;#8212; a per-skill entry of the same name overrides the global one, and gives the tool two sources of its own config that can drift.&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;get_service_protocol&lt;/b&gt; needs no verification and is the only place a protocol number is ever said aloud. The number is minted at the first rung and sent to the caller by text message, so the agent says it has gone out and nothing more; a caller who wants the number itself asks, and this is what answers (ADR-032).&lt;br&gt;&lt;b&gt;record_interaction_result&lt;/b&gt; (OnEnd) and &lt;b&gt;record_interaction_tags&lt;/b&gt; (OnEnhancedFinished) are never called by the model. They write one row of &lt;i&gt;rf_interactions_consolidated&lt;/i&gt; twice: the deeds the code already knew, then the three attitudes a judge read back off the transcript (ADR-026, ADR-027).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1110" width="1050" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
